{
  "entities": {
    "Review": {
      "title": "Review",
      "description": "A customer review and rating for Chaitra Beauty Zone",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorName": { "type": "string", "description": "The name of the reviewer" },
        "rating": { "type": "integer", "description": "Rating from 1 to 5" },
        "text": { "type": "string", "description": "The review text" },
        "date": { "type": "string", "description": "Relative date description" },
        "avatar": { "type": "string" },
        "verified": { "type": "boolean" }
      },
      "required": ["authorName", "rating", "text", "date"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "A scheduled hair salon or beauty service appointment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string", "description": "Customer name" },
        "email": { "type": "string" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "serviceId": { "type": "string", "description": "The selected salon service ID" },
        "serviceName": { "type": "string", "description": "Friendly selected service name" },
        "date": { "type": "string", "description": "Date of appointment (YYYY-MM-DD)" },
        "time": { "type": "string", "description": "Time of appointment (HH:MM)" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "description": "ISO status click timestamp" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] }
      },
      "required": [
        "customerName",
        "email",
        "phone",
        "serviceId",
        "serviceName",
        "date",
        "time",
        "createdAt",
        "status"
      ]
    }
  },
  "firestore": {
    "reviews/{reviewId}": {
      "schema": "Review",
      "description": "Public customer feedback ratings"
    },
    "appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Store user booking listings"
    }
  }
}
